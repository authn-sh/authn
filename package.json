{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "size": "size-limit"
    },
    "size-limit": [
        {
            "name": "Account Portal + Dashboard entry shims",
            "path": "public/build/assets/main-*.js",
            "limit": "20 KB",
            "gzip": true,
            "brotli": false
        },
        {
            "name": "Shared React/Inertia vendor chunk",
            "path": "public/build/assets/dist-*.js",
            "limit": "220 KB",
            "gzip": true,
            "brotli": false
        }
    ],
    "devDependencies": {
        "@inertiajs/react": "^3.0.3",
        "@size-limit/file": "^12.1.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.0.0",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "size-limit": "^12.1.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "@authn-sh/sdk-js": "^0.5.0-alpha.6",
        "@authn-sh/sdk-react": "^0.5.0-alpha.7",
        "@authn-sh/ui": "^0.5.0-alpha.6"
    }
}
